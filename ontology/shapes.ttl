@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix ex:   <http://arxiv-cs.org/ontology#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# ── SHACL shapes — data validation, distinct from the OWL axioms in arxiv_cs.ttl.
#
# OWL states what SHOULD be true (meaning); SHACL checks whether instance data
# ACTUALLY satisfies it, and reports every violation instead of declaring the
# whole graph inconsistent. See competency questions #10, #11, #12.

# Method categories are review-gated. Zero categories is a coverage warning;
# more than one disjoint category is a hard integrity violation.

ex:MethodCategoryExclusivityShape
    a sh:NodeShape ;
    sh:targetClass ex:Method ;
    sh:severity sh:Violation ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A Method must not belong to more than one of the 7 disjoint categories." ;
        sh:select """
            PREFIX ex: <http://arxiv-cs.org/ontology#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this WHERE {
                $this rdf:type ?category .
                FILTER (?category IN (
                    ex:FineTuningMethod, ex:AttentionMethod, ex:AlignmentMethod,
                    ex:ReasoningMethod, ex:RetrievalMethod,
                    ex:PersonalizationMethod, ex:AgentSkillLearningMethod
                ))
            }
            GROUP BY $this
            HAVING (COUNT(DISTINCT ?category) > 1)
        """ ;
    ] .

ex:MethodCategoryCoverageShape
    a sh:NodeShape ;
    sh:targetClass ex:Method ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Method has no reviewed category yet (informational coverage gap)." ;
        sh:select """
            PREFIX ex: <http://arxiv-cs.org/ontology#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this rdf:type ?category .
                    FILTER (?category IN (
                        ex:FineTuningMethod, ex:AttentionMethod, ex:AlignmentMethod,
                        ex:ReasoningMethod, ex:RetrievalMethod,
                        ex:PersonalizationMethod, ex:AgentSkillLearningMethod
                    ))
                }
            }
        """ ;
    ] .


# ── #11a: every Paper must have at least one author ─────────────────────────
# Hard violation — a paper with zero authors indicates a real ingestion bug.

ex:PaperShape
    a sh:NodeShape ;
    sh:targetClass ex:Paper ;
    sh:property [
        sh:path ex:authoredBy ;
        sh:minCount 1 ;
        sh:message "Paper must have at least one author." ;
    ] .


# ── #11b: an Author should have a known institution ─────────────────────────
# Warning, not a hard violation — missing institution is a known, expected
# extraction limitation (not every author's affiliation is recoverable from
# an abstract), not a sign of broken data the way a zero-author paper is.

ex:AuthorShape
    a sh:NodeShape ;
    sh:targetClass ex:Author ;
    sh:property [
        sh:path ex:fromInstitution ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Author has no known institution (informational — common extraction gap, not necessarily an error)." ;
    ] .
