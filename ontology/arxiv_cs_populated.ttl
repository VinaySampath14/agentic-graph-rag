ex:authoredBy a rdf:Property,
        rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "authored by" ;
    rdfs:comment "Relates a paper to one of its authors." ;
    rdfs:domain ex:Paper ;
    rdfs:range ex:Author ;
    rdfs:subPropertyOf ex:authoredBy .

ex:belongsToCommunity a rdf:Property,
        rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "belongs to community" ;
    rdfs:comment "Relates a paper to the Leiden-detected research community it was assigned to." ;
    rdfs:domain ex:Paper ;
    rdfs:range ex:Community ;
    rdfs:subPropertyOf ex:belongsToCommunity .

ex:communitySize a rdf:Property,
        rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "community size" ;
    rdfs:domain ex:Community ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf ex:communitySize .

ex:communityTheme a rdf:Property,
        rdfs:Resource,
        owl:DatatypeProperty ;
    rdfs:label "community theme" ;
    rdfs:domain ex:Community ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ex:communityTheme .

ex:fromInstitution a rdf:Property,
        rdfs:Resource,
        owl:ObjectProperty ;
    rdfs:label "from institution" ;
    rdfs:comment "Relates an author to their affiliated institution." ;
    rdfs:domain ex:Author ;
    rdfs:range ex:Institution ;
    rdfs:subPropertyOf ex:fromInstitution .

